{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signal-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "triggers": {
    // Daily at 06:00 UTC — rankings move on a daily timescale, and this
    // keeps Serper usage at keywords × 1 query per day. The runKey derived
    // from the scheduled time makes duplicate deliveries of a tick idempotent.
    "crons": ["0 6 * * *"]
  },
  "vars": {
    // Overridden locally by .dev.vars; set to the real deployment URL
    // (npx convex dashboard shows it) before `wrangler deploy`.
    "CONVEX_URL": "https://YOUR-DEPLOYMENT.convex.cloud"
  },
  "observability": {
    "enabled": true
  },
  // The built dashboard is served by this same Worker, so one deploy gives
  // one URL for UI + manual-trigger endpoint + cron. GETs matching a file
  // serve the asset; everything else (POST /trigger, /health) hits the code.
  "assets": {
    "directory": "../dashboard/dist",
    "not_found_handling": "single-page-application"
  }
}
