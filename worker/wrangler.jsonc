{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signal-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "triggers": {
    // Every 5 minutes. The runKey derived from the scheduled time makes
    // duplicate deliveries of a tick idempotent.
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    // Overridden locally by .dev.vars; set to the real deployment URL
    // (npx convex dashboard shows it) before `wrangler deploy`.
    "CONVEX_URL": "https://YOUR-DEPLOYMENT.convex.cloud"
  },
  "observability": {
    "enabled": true
  }
}
